# Local Docker MongoDB settings. Copy this file to .env for local development.
MONGO_INITDB_ROOT_USERNAME=regression_dev
MONGO_INITDB_ROOT_PASSWORD=change_this_local_password
MONGODB_URI=mongodb://regression_dev:change_this_local_password@127.0.0.1:27017/regression_lab?authSource=admin
MONGODB_DB_NAME=regression_lab

# Dataset files are stored outside MongoDB documents.
DATASET_STORAGE_DIR=./data/uploads
