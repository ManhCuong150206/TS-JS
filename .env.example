connection_string=mongodb://127.0.0.1:27017/hoi-quy-3d
PORT=3000
# CSV upload limit in bytes (default 10 MiB).
MAX_DATASET_FILE_SIZE=10485760
DATASET_STORAGE_DIR=./data/uploads
CORS_ORIGINS=http://localhost:4200,http://localhost:5173
# Generate a random secret (at least 32 characters in production).
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# Optional: seed the first admin only when no admin exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=
COOKIE_SECURE=false
TRUST_PROXY=false
